<script>
(function() {
  var tl = document.querySelector('.research-timeline');
  if (!tl) return;
  var B = tl.querySelectorAll('.tl-filter-btn');
  var G = tl.querySelectorAll('.tl-year-group');
  var S = tl.querySelector('.gs');
  var P = tl.querySelector('.ps');
  var SS = tl.querySelector('.ss');

  B.forEach(function(b) {
    b.addEventListener('click', function() {
      var t = b.dataset.filter;
      B.forEach(function(x) { x.classList.toggle('active', x.dataset.filter === t); });
      if (S) S.classList.toggle('visible', t === 'ghfp');
      if (P) P.classList.toggle('visible', t === 'gpa');
      if (SS) SS.classList.toggle('visible', t === 'sync');
      G.forEach(function(g) {
        var d = g.dataset.threads || '';
        g.classList.toggle('filtered-out', t !== 'all' && d.indexOf(t) === -1);
      });
      setTimeout(function() {
        G.forEach(function(g) {
          var r = g.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) g.classList.add('in-view');
        });
      }, 100);
    });
  });

  var O = new IntersectionObserver(function(e) {
    e.forEach(function(entry) {
      if (entry.isIntersecting) entry.target.classList.add('in-view');
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  G.forEach(function(g) { O.observe(g); });

  window.addEventListener('scroll', function() {
    var c = null;
    var v = window.scrollY + 80;
    G.forEach(function(g) {
      var r = g.getBoundingClientRect();
      var t = r.top + window.scrollY;
      var b = r.bottom + window.scrollY;
      if (t <= v && b >= v) c = g;
    });
    G.forEach(function(g) {
      var n = g.querySelector('.tl-year-number');
      if (n) n.style.opacity = (g === c) ? '0.30' : '0.15';
    });
  }, { passive: true });
})();
</script>
