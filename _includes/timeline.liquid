<style>
.research-timeline {
  --tl-bg: transparent;
  --tl-text: #2C2C2C;
  --tl-text-dim: #6B6B6B;
  --tl-ghfp: #005B96;
  --tl-ghfp-light: #0074BA;
  --tl-ghfp-bg: #EDF2F7;
  --tl-gpa: #8B2E2E;
  --tl-gpa-bg: #FBF0F0;
  --tl-sync: #2E7088;
  --tl-sync-bg: #EDF5F8;
  --tl-line: #D8D5CB;
  --tl-card-bg: #FAF8F4;
  font-family: "Georgia","Noto Serif CJK SC","Times New Roman",serif;
  color: var(--tl-text);
  line-height: 1.7;
}

.research-timeline .timeline-header {
  max-width: 780px;
  margin: 0 auto;
  padding: 2rem 1.5rem 2rem;
  text-align: center;
}
.research-timeline .timeline-header h1 { text-align: center; }
.research-timeline .timeline-header h1 .zh {
  display: block;
  font-family: "KaiTi", "楷体", "STKaiti", serif;
  font-size: 2.8rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #1B5E20;
}
.research-timeline .timeline-header h1 .en {
  display: block;
  font-family: "Georgia", "Times New Roman", serif;
  font-weight: 400;
  font-size: 1.25rem;
  font-style: italic;
  color: var(--tl-text-dim);
  letter-spacing: 0.01em;
  margin-top: 0.3rem;
}
.research-timeline .timeline-header .hint {
  font-size: 0.82rem;
  color: #aaa;
  margin-top: 0.35rem;
  font-family: system-ui, sans-serif;
}

.research-timeline .tl-filters {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}
.research-timeline .tl-filter-btn {
  padding: 0.45rem 1.1rem;
  border-radius: 20px;
  border: 1.5px solid var(--tl-line);
  background: transparent;
  font-size: 0.82rem;
  cursor: pointer;
  font-family: system-ui,sans-serif;
  color: var(--tl-text-dim);
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}
.research-timeline .tl-filter-btn.active { color: #fff; border-color: transparent; }
.research-timeline .tl-filter-btn.active.all { background: #444; }
.research-timeline .tl-filter-btn.active.ghfp { background: var(--tl-ghfp); }
.research-timeline .tl-filter-btn.active.gpa { background: var(--tl-gpa); }
.research-timeline .tl-filter-btn.active.sync { background: var(--tl-sync); }

.research-timeline .tl-timeline {
  position: relative;
  max-width: 780px;
  margin: 0 auto;
  padding: 0 1.5rem 5rem;
}
.research-timeline .tl-timeline::before {
  content: '';
  position: absolute;
  left: 7.2rem;
  top: 0;
  bottom: 0;
  width: 1px;
  background: var(--tl-line);
}

.research-timeline .tl-year-group {
  position: relative;
  margin-bottom: 3.5rem;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.5s, transform 0.5s;
}
.research-timeline .tl-year-group.in-view { opacity: 1; transform: translateY(0); }
.research-timeline .tl-year-group:last-child { margin-bottom: 0; }
.research-timeline .tl-year-group.filtered-out {
  opacity: 0.10;
  pointer-events: none;
  transform: translateY(0);
}

.research-timeline .tl-year-marker {
  position: sticky;
  top: 1rem;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.research-timeline .tl-year-number {
  font-size: 4.5rem;
  font-weight: 700;
  line-height: 1;
  min-width: 5.5rem;
  text-align: right;
  opacity: 0.15;
  letter-spacing: -0.03em;
  transition: opacity 0.3s;
}
.research-timeline .tl-year-group.in-view .tl-year-number { opacity: 0.30; }

.research-timeline .tl-items { margin-left: 8rem; }

.research-timeline .tl-card {
  margin-bottom: 1.25rem;
  border-radius: 10px;
  background: var(--tl-card-bg);
  transition: transform 0.2s, box-shadow 0.2s;
  position: relative;
  cursor: pointer;
}
.research-timeline .tl-card:hover {
  transform: translateX(2px);
  box-shadow: 0 3px 12px rgba(0,0,0,0.08);
}
.research-timeline .tl-card:last-child { margin-bottom: 0; }

.research-timeline .tl-card::before {
  content: '';
  position: absolute;
  left: -2.46rem;
  top: 2.2rem;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2.5px solid #fff;
  z-index: 2;
  pointer-events: none;
  box-shadow: 0 0 0 1px rgba(0,0,0,0.08);
}
.research-timeline .tl-card.tl-ghfp::before { background: var(--tl-ghfp); }
.research-timeline .tl-card.tl-gpa::before  { background: var(--tl-gpa); }
.research-timeline .tl-card.tl-sync::before { background: var(--tl-sync); }
.research-timeline .tl-card::after {
  content: '';
  position: absolute;
  left: -2.1rem;
  top: 2.25rem;
  width: 1.6rem;
  height: 1px;
  background: var(--tl-line);
  pointer-events: none;
}

.research-timeline .tl-card-bar-top {
  padding: 0.45rem 1.25rem;
  font-size: 0.7rem;
  letter-spacing: 0.04em;
  color: #fff;
  border-radius: 10px 10px 0 0;
  font-family: system-ui,sans-serif;
  font-weight: 500;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.research-timeline .tl-card-bar-top .tl-publisher {
  font-size: 0.7rem;
  color: rgba(255,255,255,0.85);
  font-weight: 400;
  letter-spacing: 0.03em;
}
.research-timeline .tl-card.tl-ghfp .tl-card-bar-top {
  background: linear-gradient(90deg, #00395E 0%, var(--tl-ghfp) 30%, var(--tl-ghfp-light) 70%, #0088D4 100%);
}
.research-timeline .tl-card.tl-gpa .tl-card-bar-top {
  background-color: var(--tl-gpa);
  background-image: repeating-linear-gradient(-35deg, transparent, transparent 7px, rgba(255,255,255,0.09) 7px, rgba(255,255,255,0.09) 14px);
}
.research-timeline .tl-card.tl-sync .tl-card-bar-top {
  background: linear-gradient(90deg, #1A4A5A 0%, var(--tl-sync) 30%, #3A90A8 70%, #4AACC8 100%);
}

.research-timeline .tl-card-body {
  padding: 0.65rem 1.25rem 0.5rem 1.25rem;
  display: flex;
  gap: 1rem;
  align-items: flex-start;
}
.research-timeline .tl-card-img {
  width: 56px;
  height: 70px;
  object-fit: cover;
  border-radius: 3px;
  flex-shrink: 0;
}
.research-timeline .tl-card-txt { flex: 1; min-width: 0; }
.research-timeline .tl-card-title {
  font-size: 0.92rem;
  line-height: 1.45;
  font-weight: 600;
  margin-bottom: 0.3rem;
}
.research-timeline .tl-card-desc {
  font-size: 0.8rem;
  line-height: 1.4;
  color: var(--tl-text-dim);
}

.research-timeline .tl-card-bar-bot {
  padding: 0.2rem 1.25rem;
  font-size: 0.75rem;
  font-family: system-ui,sans-serif;
  background: #5B8C6F;
  border-radius: 0 0 10px 10px;
  display: flex;
  align-items: center;
  gap: 1.2rem;
}
.research-timeline .tl-card-bar-bot a {
  color: #fff;
  text-decoration: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  transition: opacity 0.15s;
  font-size: 0.76rem;
}
.research-timeline .tl-card-bar-bot a:hover { opacity: 0.85; }
.research-timeline .tl-card-bar-bot svg {
  width: 13px;
  height: 13px;
  color: #C8D6CC;
  flex-shrink: 0;
}

.research-timeline .tl-thread-section {
  margin: 2.5rem 0 1.5rem 8rem;
  padding: 0.6rem 1rem;
  border-radius: 4px;
  font-size: 0.82rem;
  font-weight: 600;
  font-family: system-ui,sans-serif;
  display: none;
}
.research-timeline .tl-thread-section.visible { display: block; }
.research-timeline .tl-thread-section.gs {
  background: var(--tl-ghfp-bg);
  color: var(--tl-ghfp);
  border-left: 3px solid var(--tl-ghfp);
}
.research-timeline .tl-thread-section.ps {
  background: var(--tl-gpa-bg);
  color: var(--tl-gpa);
  border-left: 3px solid var(--tl-gpa);
}
.research-timeline .tl-thread-section.ss {
  background: var(--tl-sync-bg);
  color: var(--tl-sync);
  border-left: 3px solid var(--tl-sync);
}

@media (max-width: 640px) {
  .research-timeline .tl-timeline::before { left: 3.5rem; }
  .research-timeline .tl-items { margin-left: 4.5rem; }
  .research-timeline .tl-thread-section { margin-left: 4.5rem; }
  .research-timeline .tl-year-number { font-size: 3rem; min-width: 3rem; }
  .research-timeline .tl-card::before { left: -1.7rem; top: 1.8rem; }
  .research-timeline .tl-card::after { left: -1.3rem; width: 0.8rem; top: 1.85rem; }
  .research-timeline .tl-card-body { padding: 0.5rem 1rem 0.5rem 1rem; }
  .research-timeline .tl-card-bar-bot { padding: 0.2rem 1rem; font-size: 0.7rem; }
  .research-timeline .tl-card-bar-top { padding: 0.4rem 1rem; font-size: 0.7rem; }
  .research-timeline .timeline-header { padding: 1.5rem 1rem 1.5rem; }
  .research-timeline .timeline-header h1 .zh { font-size: 2rem; }
  .research-timeline .timeline-header h1 .en { font-size: 1rem; }
}
@media (prefers-reduced-motion: reduce) {
  .research-timeline .tl-year-group { opacity: 1; transform: none; transition: none; }
}
</style>

