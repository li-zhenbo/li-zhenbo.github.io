---
layout: default
---
<style>
  /* 锁定首页最小宽度，窄屏不改变布局，超出部分横向滚动 */
  html { overflow-x: auto; }
  body { min-width: 780px; }
  /* 模块间距：简介→News→Posts→Timeline→Publications→Social */
  .post article > h2 { margin-top: 3rem; }
  .post .research-timeline { margin-top: 2.5rem; }
  .post .social { margin-top: 2.5rem; }
  /* 模块装饰分隔条 */
  .post article > h2 {
    display: flex; align-items: center; gap: 0.6rem;
    border-bottom: none; padding-bottom: 0;
  }
  .post article > h2::after {
    content: ''; flex: 1; height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, #005B96 0%, #0074BA 40%, #E0DDD5 40%, #E0DDD5 100%);
    opacity: 0.7;
  }
  /* 兴趣标签 —— 大脑图+标签环绕 */
  .interest-zone {
    position: relative; width: 100%; max-width: 500px; height: 400px;
    margin: 2rem auto 0.5rem;
  }
  .interest-brain {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 210px; height: auto;
  }
  .interest-tag {
    position: absolute;
    padding: 0.38rem 1rem; border-radius: 18px;
    font-size: 0.82rem; font-family: system-ui,sans-serif;
    font-weight: 500; color: #fff; letter-spacing: 0.02em;
    box-shadow: 0 2px 6px rgba(0,0,0,0.12);
    white-space: nowrap; transition: transform 0.15s; z-index: 2;
  }
  .interest-tag:hover { transform: translateY(-1px); }
  .interest-tag.t1 { background: #005B96; top: 0; left: 50%; transform: translateX(-50%); }
  .interest-tag.t2 { background: #1A7A4C; top: 55px; right: 0; }
  .interest-tag.t3 { background: #8B2E2E; bottom: 110px; right: 5px; }
  .interest-tag.t4 { background: #6B4E9B; bottom: 55px; right: 20px; }
  .interest-tag.t5 { background: #C26D1A; bottom: 0; left: 50%; transform: translateX(-50%); }
  .interest-tag.t6 { background: #3A7D8C; top: 95px; left: 0; }
  /* 统计卡片 */
  .pub-stats {
    display: flex; gap: 1.5rem; justify-content: center;
    margin: 2rem 0 2.5rem 0;
  }
  .pub-stat {
    text-align: center; padding: 1.2rem 2rem; border-radius: 12px;
    min-width: 120px; border: 1px solid #E8E5DB;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .pub-stat.s-journals  { background: linear-gradient(135deg, #EDF5FB 0%, #E3EEF7 100%); }
  .pub-stat.s-conferences { background: linear-gradient(135deg, #F4F0F9 0%, #EDE5F5 100%); }
  .pub-stat.s-monographs { background: linear-gradient(135deg, #FDF8EE 0%, #F9F0DA 100%); }
  .pub-stat .num {
    font-size: 2.4rem; font-weight: 700; line-height: 1.15; font-family: "Georgia",serif;
  }
  .pub-stat.s-journals .num  { color: #005B96; }
  .pub-stat.s-conferences .num { color: #6B4E9B; }
  .pub-stat.s-monographs .num { color: #C26D1A; }
  .pub-stat .label {
    font-size: 0.72rem; color: #888; margin-top: 0.3rem;
    font-family: system-ui,sans-serif; letter-spacing: 0.03em; text-transform: uppercase;
  }
</style>
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Research Interest Tags -->
    <div class="interest-zone">
      <img class="interest-brain" src="/assets/img/brain2.JPG" alt="" loading="lazy">
      <span class="interest-tag t1">非线性动力学</span>
      <span class="interest-tag t2">分岔与混沌</span>
      <span class="interest-tag t3">极限环</span>
      <span class="interest-tag t4">摄动方法</span>
      <span class="interest-tag t5">耦合 SD 振子</span>
      <span class="interest-tag t6">同异宿轨道</span>
    </div>

    <!-- News -->
    {% if site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest {{ site.latest_posts.limit }} posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Research Timeline -->
    {% include timeline.liquid %}

    <!-- Publication Statistics -->
    <div class="pub-stats">
      <div class="pub-stat s-journals"><div class="num">{{ site.data.pubstats.journals }}</div><div class="label">期刊论文</div></div>
      <div class="pub-stat s-conferences"><div class="num">{{ site.data.pubstats.conferences }}</div><div class="label">会议论文</div></div>
      <div class="pub-stat s-monographs"><div class="num">{{ site.data.pubstats.monographs }}</div><div class="label">专著</div></div>
    </div>

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
