=============================================================================
论文列表：每篇论文一个 BibTeX 条目，网站会自动按年份倒序展示。
Adding a paper = adding one BibTeX entry here. The site renders them by year.

常用可选字段（不需要的字段直接删掉该行）：
  abbr             会议/期刊缩写徽标，如 {NeurIPS}
  selected         {true} 表示精选论文，会显示在首页
  abstract         摘要（建议中英对照写在一起）
  additional_info  补充信息（支持 Markdown），推荐用来写「核心结论」
  pdf              PDF 文件名（文件放 assets/pdf/ 下）或完整 URL
  code             代码仓库 URL
  video / slides / poster / blog / website   其他材料链接
  bibtex_show      {true} 显示 BibTeX 引用按钮
  preview          摘要图文件名（图片放 assets/img/publication_preview/）
  doi / arxiv      标识符（会自动生成链接）
=============================================================================

@article{li2026quantitative,
  abbr            = {Phys. Scr.},
  bibtex_show     = {true},
  title           = {Quantitative Analysis of Dynamical Bifurcations in a Coupled Smooth and Discontinuous Oscillator with High-order Nonlinear Damping},
  author          = {Li, Zhenbo and Hou, Linxia and Peng, Ruyue},
  journal         = {Physica Scripta},
  volume          = {101},
  number          = {12},
  pages           = {125205},
  year            = {2026},
  doi             = {10.1088/1402-4896/ae5134},
  pdf             = {li2026-coupled-sd-oscillator.pdf},
  preview         = {fig19-preview.png},
  abstract        = {The quantitative analysis of the coupled smooth and discontinuous (SD) oscillator remains challenging due to its two irrational nonlinear terms. This paper proposes a modified generalized harmonic function perturbation (MGHFP) method to investigate the global evolution of limit cycles in a nonlinearly damped coupled SD oscillator. Analytical expressions for the relationship between amplitude and system parameters are derived, and a stability criterion is established. Both single-well and triple-well configurations are analyzed, with critical values for homo-heteroclinic bifurcation parameters predicted for the triple-well case. All analytical results are validated against the Runge-Kutta method.},
  additional_info = {**核心结论**：MGHFP 实现极限环振幅—参数定量预测、稳定性解析判据、同异宿分岔参数预测、高阶阻尼适用范围验证 — 全部与 Runge-Kutta 解析一致。},
  selected        = {true}
}

