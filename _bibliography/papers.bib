=============================================================================
论文列表：每篇论文一个 BibTeX 条目，网站会自动按年份倒序展示。
Adding a paper = adding one BibTeX entry here. The site renders them by year.

常用可选字段（不需要的字段直接删掉该行）：
  abbr             会议/期刊缩写徽标，如 {NeurIPS}
  selected         {true} 表示精选论文，会显示在首页
  abstract         摘要（建议中英对照写在一起）
  additional_info  补充信息（支持 Markdown），推荐用来写「核心结论」
  pdf              PDF 文件名（文件放 assets/pdf/ 下）或完整 URL
  code             代码仓库 URL
  video / slides / poster / blog / website   其他材料链接
  bibtex_show      {true} 显示 BibTeX 引用按钮
  preview          摘要图文件名（图片放 assets/img/publication_preview/）
  doi / arxiv      标识符（会自动生成链接）
=============================================================================

@article{li2026quantitative,
  abbr            = {Phys. Scr.},
  bibtex_show     = {true},
  title           = {Quantitative Analysis of Dynamical Bifurcations in a Coupled Smooth and Discontinuous Oscillator with High-order Nonlinear Damping},
  author          = {Li, Zhenbo and Hou, Linxia and Peng, Ruyue},
  journal         = {Physica Scripta},
  volume          = {101},
  number          = {12},
  pages           = {125205},
  year            = {2026},
  doi             = {10.1088/1402-4896/ae5134},
  pdf             = {li2026-coupled-sd-oscillator.pdf},
  preview         = {publication_preview/li2026-fig19-preview.png},
  abstract        = {The quantitative analysis of the coupled smooth and discontinuous (SD) oscillator remains challenging due to its two irrational nonlinear terms. This paper proposes a modified generalized harmonic function perturbation (MGHFP) method to investigate the global evolution of limit cycles in a nonlinearly damped coupled SD oscillator. Analytical expressions for the relationship between amplitude and system parameters are derived, and a stability criterion is established. Both single-well and triple-well configurations are analyzed, with critical values for homo-heteroclinic bifurcation parameters predicted for the triple-well case. All analytical results are validated against the Runge-Kutta method. 耦合光滑非连续振子因其两个无理非线性项，定量分析极具挑战性。本文提出改进广义谐波函数摄动法（MGHFP），对含高阶非线性阻尼的耦合 SD 振子的全局极限环演化进行定量分析，并给出稳定性判据。在单阱和三阱条件下均进行了验证，三阱系统还预测了同异宿分岔参数临界值。全部解析结果与 Runge-Kutta 数值方法高度一致。},
  additional_info = {**核心结论 Key findings**：(1) MGHFP 方法可以解析地获得极限环振幅与控制参数 μc 的关系式，实现极限环生命周期（产生→演化→终止）的全定量预测；(2) 建立了极限环稳定性的解析判据，能够判断每个极限环稳定、不稳定还是半稳定——后者纯数值方法极难捕捉；(3) 针对三阱耦合 SD 振子，同时预测了同宿与异宿分岔参数，并给出近似解析解；(4) 验证了高阶非线性阻尼（含四次项）下该方法的适用范围：当 |εμi| ⩽ 0.5 时精度可靠，超过此范围可提升截断阶数补偿。},
  selected        = {true}
}

