@article{li2026quantitative,
  abbr            = {Phys. Scr.},
  bibtex_show     = {true},
  title           = {Quantitative Analysis of Dynamical Bifurcations in a Coupled Smooth and Discontinuous Oscillator with High-order Nonlinear Damping},
  author          = {Li, Zhenbo and Hou, Linxia and Peng, Ruyue},
  journal         = {Physica Scripta},
  volume          = {101},
  number          = {12},
  pages           = {125205},
  year            = {2026},
  doi             = {10.1088/1402-4896/ae5134},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary.pdf},
  preview         = {physica-scripta-cover.png},
  abstract        = {The quantitative analysis of the coupled smooth and discontinuous (SD) oscillator remains challenging due to its two irrational nonlinear terms, and few studies have been conducted on it to date. This paper proposes a modified generalized harmonic function perturbation method to investigate the global evolution of limit cycles in a nonlinear damped coupled SD oscillator. This approach enables the derivation of an analytical relationship for the limit cycle amplitude as a function of the system parameters. Furthermore, an analytical stability criterion for the limit cycles is established based on the qualitative theory of ordinary differential equations. To validate the effectiveness of the proposed method, quantitative analyses are carried out for both single-well and triple-well coupled SD oscillators. In particular, critical values of the homo-heteroclinic bifurcation parameters are also predicted for the triple-well system. Additionally, approximate analytical solutions for the limit cycles and homo-heteroclinic orbits are obtained. Based on these results, global evolution of the limit cycles can be quantitatively analyzed. All analytical findings are compared with results from the Runge-Kutta method, confirming the feasibility and reliability of the proposed approach.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;A modified generalized harmonic function perturbation method for quantitative limit cycle analysis of coupled SD oscillators with high-order nonlinear damping. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2024modified,
  abbr            = {IJNLM},
  bibtex_show     = {true},
  title           = {A Modified Generalized Harmonic Function Perturbation Method and Its Application in Analyzing Generalized {Duffing–Harmonic–Rayleigh–Liénard} Oscillator},
  author          = {Li, Zhenbo and Cai, Jin and Hou, Linxia},
  journal         = {International Journal of Non-Linear Mechanics},
  volume          = {166},
  pages           = {104832},
  year            = {2024},
  doi             = {10.1016/j.ijnonlinmec.2024.104832},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p3.pdf},
  preview         = {ijnlm-cover-p3.png},
  abstract        = {A modified generalized harmonic function perturbation method (MGHFP) is proposed in this paper. Compared with the classical version, the modified version can execute its procedures purely symbolically without the need to assign any system parameters even for complicated nonlinear oscillators. This means that the relations between amplitude of limit cycles and system parameters can be derived analytically. Meanwhile, the analytical expression of characteristic quantity of limit cycles can be also obtained. Via these analytical expressions, the evolutional process of limit cycles can be studied quantitatively in amplitude domain. It demonstrates the entire live period of each limit cycle from its generation to bifurcation to destination. To show the feasibility, a generalized Duffing–Harmonic–Rayleigh–Liénard oscillator is investigated. The global evolution of its limit cycles are analyzed quantitatively, and critical values of homoclinic and heteroclinic bifurcation parameters are also predicted. Analytical approximate solutions of both limit cycles and homo-heteroclinic orbits are calculated. All results are confirmed by the Runge–Kutta method.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;The foundational paper of the MGHFP method series — introduces composite Simpson integration into the GHFP framework for purely symbolic global dynamic analysis of strongly nonlinear oscillators. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2024modified2,
  abbr            = {Phys. Scr.},
  bibtex_show     = {true},
  title           = {A Modified Perturbation Method for Global Dynamic Analysis of Generalized Mixed {Rayleigh–Liénard} Oscillator with Cubic and Quintic Nonlinearities},
  author          = {Li, Zhenbo and Hou, Linxia and Zhang, Yiqing and Xu, Feng},
  journal         = {Physica Scripta},
  volume          = {99},
  number          = {7},
  pages           = {075213},
  year            = {2024},
  doi             = {10.1088/1402-4896/ad5066},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p4.pdf},
  preview         = {physica-scripta-cover-p4.png},
  abstract        = {Deriving analytical relationship between the system parameters and amplitude of the limit cycle is a meaningful and challenging task. Currently, numerous existing analytical approximate methods struggle to achieve this goal when expressions of restoring force or nonlinear damping is complicated. To overcome this shortcoming, this study proposes a modified generalized harmonic function perturbation method. Using the proposed method, a generalized mixed Rayleigh–Liénard oscillator with cubic and quintic nonlinearities was investigated. The analytical relationships between the system parameters and amplitude of the limit cycle, as well as the expression of its characteristic quantity, were derived. By employing these analytical relationships, the existence, stability, number, position, and amplitude of each limit cycle are quantitatively analysed. The homoclinic and heteroclinic bifurcations were also predicted using the above analytical relationships. Additionally, analytical approximate solutions for this oscillator were calculated using the proposed method. All results obtained in this study were subsequently confirmed numerically to demonstrate their feasibility and validity.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;The first Physica Scripta paper introducing the modified GHFP method — quantitative analysis of limit cycles in a mixed Rayleigh–Liénard oscillator with cubic and quintic nonlinearities. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2013generalized,
  abbr            = {JSV},
  bibtex_show     = {true},
  title           = {A Generalized Harmonic Function Perturbation Method for Determining Limit Cycles and Homoclinic Orbits of {Helmholtz–Duffing} Oscillator},
  author          = {Li, Zhenbo and Tang, Jiashi and Cai, Ping},
  journal         = {Journal of Sound and Vibration},
  volume          = {332},
  number          = {21},
  pages           = {5508--5522},
  year            = {2013},
  doi             = {10.1016/j.jsv.2013.05.007},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p5.pdf},
  preview         = {jsv-cover.png},
  abstract        = {In this paper, a novel description of periodic solution and homoclinic orbit of undamped Helmholtz–Duffing oscillator is proposed via nonlinear time transformation. Based on this novel description, a generalized harmonic function perturbation method is presented to determine the limit cycles and homoclinic orbits of Helmholtz–Duffing oscillator with nonlinear damping. The amplitude of limit cycle and critical value of the homoclinic bifurcation parameter can be also predicted. To illustrate the accuracy of the present method, the solutions obtained in this paper are compared with those of Runge–Kutta method, which shows the method proposed in this paper is effective and feasible.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;The foundational paper proposing the generalized harmonic function perturbation (GHFP) method — introduces the quadratic generalized harmonic function and nonlinear time transformation for determining limit cycles and homoclinic orbits of Helmholtz–Duffing oscillators. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2016predicting,
  abbr            = {QTDS},
  bibtex_show     = {true},
  title           = {Predicting Homoclinic and Heteroclinic Bifurcation of Generalized {Duffing–Harmonic–van de Pol} Oscillator},
  author          = {Li, Zhenbo and Tang, Jiashi and Cai, Ping},
  journal         = {Qualitative Theory of Dynamical Systems},
  volume          = {15},
  number          = {1},
  pages           = {19--37},
  year            = {2016},
  doi             = {10.1007/s12346-015-0138-z},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p6.pdf},
  preview         = {qtds-cover.png},
  abstract        = {In this paper, a novel construction of solutions of nonlinear oscillators are proposed which can be called as the quadratic generalized harmonic function. Based on this novel solution, a modified generalized harmonic function Lindstedt–Poincaré method is presented which call the quadratic generalized harmonic function perturbation method. Via this method, the homoclinic and heteroclinic bifurcations of Duffing-harmonic-van de Pol oscillator are investigated. The critical value of the homoclinic and heteroclinic bifurcation parameters are predicted. Meanwhile, the analytical solutions of homoclinic and heteroclinic orbits of this oscillator are also attained. To illustrate the accuracy of the present method, all the above-mentioned results are compared with those of Runge–Kutta method, which shows that the proposed method is effective and feasible. In addition, the present method can be utilized in study many other oscillators.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;Extends the GHFP method to Duffing-harmonic-van de Pol oscillator with rational restoring force — predicts homoclinic and heteroclinic bifurcation parameters analytically. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2025global,
  abbr            = {IJNLM},
  bibtex_show     = {true},
  title           = {Global Evolution of Limit Cycles and Homoclinic Bifurcation of Smooth and Discontinuous Oscillator with Quartic Nonlinear Damping},
  author          = {Li, Zhenbo and Hou, Linxia and Peng, Ruyue},
  journal         = {International Journal of Non-Linear Mechanics},
  volume          = {178},
  pages           = {105185},
  year            = {2025},
  doi             = {10.1016/j.ijnonlinmec.2025.105185},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p2.pdf},
  preview         = {ijnlm-cover.png},
  abstract        = {As a typical model of irrational oscillator, the smooth and discontinuous (SD) oscillator has been researched intensively in these few years. However, the researches on nonlinear damped SD oscillator are still rare. Therefore, this work is devoted to the quantitative analysis of certain SD oscillator with quartic nonlinear damping. First, by introducing the Pade approximation method into the modified generalized harmonic function perturbation method, the latter one has been further improved. Via this method, the limit cycle's amplitude-system parameter relationship, as well as the stability criterion about limit cycle, are derived analytically. By utilizing these relationships, the global evolution of each limit cycle and its homoclinic bifurcation are analyzed quantitatively and analytically with respect to single parameter and multi-parameters. These analyses answer the questions such as when a limit cycle emerges, how it bifurcates, and where it converges. Additionally, the analytical approximate solution of limit cycle and homoclinic orbits are also obtained. To show the effectiveness, several calculation examples are presented and analyzed elaborately. To demonstrate the accuracy, all results obtained in this paper are confirmed by Runge-Kutta method.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;MGHFP + Pade approximation for global limit cycle evolution and homoclinic bifurcation in the SD oscillator with quartic nonlinear damping. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2014generalized,
  abbr            = {Chin. Phys. B},
  bibtex_show     = {true},
  title           = {A Generalized {Padé} Approximation Method of Solving Homoclinic and Heteroclinic Orbits of Strongly Nonlinear Autonomous Oscillators},
  author          = {Li, Zhenbo and Tang, Jiashi and Cai, Ping},
  journal         = {Chinese Physics B},
  volume          = {23},
  number          = {12},
  pages           = {120501},
  year            = {2014},
  doi             = {10.1088/1674-1056/23/12/120501},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p8.pdf},
  preview         = {cpb-cover.png},
  abstract        = {An intrinsic extension of Padé approximation method, called the generalized Padé approximation method, is proposed based on the classic Padé approximation theorem. According to the proposed method, the numerator and denominator of Padé approximant are extended from polynomial functions to a series composed of any kind of function, which means that the generalized Padé approximant is not limited to some forms, but can be constructed in different forms in solving different problems. Thus, many existing modifications of Padé approximation method can be considered to be the special cases of the proposed method. For solving homoclinic and heteroclinic orbits of strongly nonlinear autonomous oscillators, two novel kinds of generalized Padé approximants are constructed. Then, some examples are given to show the validity of the present method. To show the accuracy of the method, all solutions obtained in this paper are compared with those of the Runge–Kutta method.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;The English version of the generalized Padé approximation method — extended to both homoclinic and heteroclinic orbits for Duffing, Φ⁶, and Duffing-harmonic oscillators. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2019cosine,
  abbr            = {J. Vib. Shock},
  bibtex_show     = {true},
  title           = {A Cosine Generalized {Padé} Approximation Method and Its Application in Solving Periodic Solutions of Strongly Nonlinear Oscillators},
  author          = {Li, Zhenbo and Tang, Jiashi},
  journal         = {Journal of Vibration and Shock},
  volume          = {38},
  number          = {22},
  pages           = {159--167},
  year            = {2019},
  doi             = {10.13465/j.cnki.jvs.2019.22.023},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p9.pdf},
  preview         = {jvs-cover-p9.png},
  abstract        = {Based on the generalized Padé approximation method, a novel cosine-type generalized Padé approximant whose numerator and denominator are both series composed of cosine functions is constructed. The solving procedure of the generalized Padé approximation method is improved for periodic orbits of different types of oscillators. The improved method is then applied to obtain analytical approximate periodic solutions for a class of oscillators whose potential energy functions are high-order polynomials, rational functions, and irrational functions. Comparisons with numerical solutions verify that the obtained solutions have high accuracy and reliability, independent of the magnitude of nonlinear coefficients and initial amplitude. The method is not limited to specific systems but has a wide range of applicability.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;Constructs a cosine-type generalized Padé approximant with inherent periodicity — enabling direct Padé approximation of periodic solutions for strongly nonlinear oscillators with polynomial, rational, and irrational potentials. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2016generalized,
  abbr            = {Nonlinear Dyn.},
  bibtex_show     = {true},
  title           = {A Generalized {Padé}–{Lindstedt}–{Poincaré} Method for Predicting Homoclinic and Heteroclinic Bifurcations of Strongly Nonlinear Autonomous Oscillators},
  author          = {Li, Zhenbo and Tang, Jiashi},
  journal         = {Nonlinear Dynamics},
  volume          = {84},
  number          = {3},
  pages           = {1201--1223},
  year            = {2016},
  doi             = {10.1007/s11071-015-2563-6},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p10.pdf},
  preview         = {nody-cover.png},
  abstract        = {A generalized Padé–Lindstedt–Poincaré method is proposed for predicting homoclinic and heteroclinic bifurcations of strongly nonlinear autonomous oscillators. Several types of generalized Padé approximants are introduced into the Lindstedt–Poincaré procedure, replacing the conventional integration steps. This avoids the cumbersome calculations of derivation and integration, enabling high-order perturbation solutions to be obtained easily. The method is applied to Helmholtz–Duffing, Duffing-harmonic, and SD oscillators, predicting critical values of homoclinic and heteroclinic bifurcation parameters. All results are confirmed by the Runge–Kutta method.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;Generalized Padé–Lindstedt–Poincaré method — replaces integration in L–P procedure with Padé approximation, enabling high-order homoclinic/heteroclinic bifurcation prediction. **Essential summary available via the PDF button above.**},
  selected        = {true}
}

@article{li2022high,
  abbr            = {J. Vib. Eng. Technol.},
  bibtex_show     = {true},
  title           = {High Accurate Homo-{Heteroclinic} Solutions of Certain Strongly Nonlinear Oscillators Based on Generalized {Padé}–{Lindstedt}–{Poincaré} Method},
  author          = {Li, Zhenbo and Tang, Jiashi},
  journal         = {Journal of Vibration Engineering \& Technologies},
  volume          = {10},
  number          = {4},
  pages           = {1291--1308},
  year            = {2022},
  doi             = {10.1007/s42417-022-00446-7},
  dimensions      = {true},
  altmetric       = {true},
  pdf             = {essential-summary-p11.pdf},
  preview         = {jvet-cover.png},
  abstract        = {The generalized Padé–Lindstedt–Poincaré method is applied to obtain high accurate homoclinic and heteroclinic solutions of the entire Φ⁶-Van der Pol oscillator with asymmetric potential and the generalized Duffing-Harmonic-Van der Pol oscillator. To improve efficiency and accuracy, several new types of generalized Padé approximant are constructed and introduced. Perturbation equations from Lindstedt–Poincaré are solved by generalized Padé approximation instead of traditional integration. Solutions for oscillators with both small and large parameters are obtained, showing high agreement with Runge–Kutta results.},
  additional_info = {&nbsp;&nbsp;—&nbsp;&nbsp;Extends the GPLP method to Φ⁶-Van der Pol and Duffing-Harmonic-Van der Pol oscillators with asymmetric potentials. **Essential summary available via the PDF button above.**},
