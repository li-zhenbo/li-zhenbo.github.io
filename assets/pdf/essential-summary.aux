\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Figure 1.} (Upper) Relationship between limit cycle amplitude $A$ and control parameter $\mu _c$. (Lower) Characteristic quantity $h_0$ determining stability. Key bifurcation points: $\mu ^{(0)}=-0.1249$ (semi-stable cycle emerges), $\mu ^{(1)}=-0.05$ (splits into stable + unstable), $\mu ^{(2)}=0.02$ (unstable cycle collapses to singular point).}}{4}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Figure 2.} Phase portraits of limit cycles at different $\mu _c$ values ($\varepsilon =0.2$). Solid lines: Runge--Kutta numerical integration. Dotted lines: present MGHFP analytical method. The excellent agreement validates accuracy even at moderately large $\varepsilon $.}}{5}{figure.3}\protected@file@percent }
